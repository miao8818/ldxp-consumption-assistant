{
  "manifest_version": 3,
  "name": "链动小铺消费助手（非官方）",
  "version": "1.2.0",
  "description": "永久免费：在链动小铺订单列表中统计每日消费，并按关键字、金额、日期和状态筛选。",
  "author": "miao8818",
  "homepage_url": "https://github.com/miao8818/ldxp-consumption-assistant",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pay.ldxp.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css",
        "assets/qq-group.jpg"
      ],
      "matches": [
        "https://pay.ldxp.cn/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "打开链动小铺消费助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pay.ldxp.cn/order*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pay.ldxp.cn/order*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
